<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Extended Comp"
          extraClientlibs="[wknd.components.extendedComp.editor]"
          sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
                            <slides
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldLabel="Slides">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./slides">
                                    <items jcr:primaryType="nt:unstructured">
                                        <slideType
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                            granite:class="cq-dialog-dropdown-mediatype"
                                            fieldLabel="Media Type"
                                            name="./slideType">
                                            <items jcr:primaryType="nt:unstructured">
                                                <image
                                                    jcr:primaryType="nt:unstructured"
                                                    selected="{Boolean}true"
                                                    text="Image"
                                                    value="image"/>
                                                <video
                                                    jcr:primaryType="nt:unstructured"
                                                    text="Video"
                                                    value="video"/>
                                            </items>
                                        </slideType>
                                        <imageContainer
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container"
                                            granite:class="image-container media-toggle-target">
                                            <items jcr:primaryType="nt:unstructured">
                                                <imagePath
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    fieldLabel="Select Image"
                                                    name="./assetPath"
                                                    rootPath="/content/dam"
                                                    required="{Boolean}true"/>
                                            </items>
                                        </imageContainer>
                                        <videoContainer
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container"
                                            granite:class="video-container media-toggle-target"
                                            style="display:none">

                                            <items jcr:primaryType="nt:unstructured">
                                                <videoPath
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    fieldLabel="Select Video"
                                                    name="./assetPath"
                                                    rootPath="/content/dam"
                                                    />
                                                <thumbnailPath
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    fieldLabel="Video Thumbnail"
                                                    name="./thumbnailPath"
                                                    rootPath="/content/dam"
                                                    />
                                            </items>
                                        </videoContainer>
                                        <overlayLabels
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                            fieldLabel="Overlay Labels (e.g. Flash Sale)"
                                            name="./overlayLabels"
                                            composite="{Boolean}false">
                                            <field
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                name="./overlayLabels"
                                                emptyText="e.g. Flash Sale"/>
                                        </overlayLabels>
                                    </items>
                                </field>
                            </slides>
                        </items>
    </content>
</jcr:root>