<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          jcr:primaryType="nt:unstructured"
          jcr:title="Media Gallery Banner"
          sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <slidesTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Slides"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <slides
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldLabel="Slides">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./slides">
                                    <items jcr:primaryType="nt:unstructured">
                                        <slideType
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                            fieldLabel="Media Type"
                                            name="./slideType">
                                            <items jcr:primaryType="nt:unstructured">
                                                <image
                                                    jcr:primaryType="nt:unstructured"
                                                    selected="{Boolean}true"
                                                    text="Image"
                                                    value="image"/>
                                                <video
                                                    jcr:primaryType="nt:unstructured"
                                                    text="Video"
                                                    value="video"/>
                                            </items>
                                        </slideType>
                                        <assetPath
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Asset Path (Image or Video in DAM)"
                                            name="./assetPath"
                                            rootPath="/content/dam"
                                            required="{Boolean}true"/>
                                        <thumbnailPath
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldLabel="Video Thumbnail Image (DAM) – required for video type"
                                            emptyText="Select a thumbnail image from DAM"
                                            name="./thumbnailPath"
                                            rootPath="/content/dam"/>
                                        <altText
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Alt Text"
                                            emptyText="Describe the image for accessibility"
                                            name="./altText"/>
                                        <overlayLabels
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                            fieldLabel="Overlay Labels (e.g. Flash Sale)"
                                            name="./overlayLabels">
                                            <field
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                emptyText="e.g. Flash Sale"/>
                                        </overlayLabels>
                                    </items>
                                </field>
                            </slides>
                        </items>
                    </slidesTab>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>